# Αντέγραψε σε .env:  cp .env.example .env && chmod 600 .env

# Έκδοση Stalwart - πάντα συγκεκριμένη (όχι latest) για παραγωγή.
# Νέες εκδόσεις: https://github.com/stalwartlabs/stalwart/releases
STALWART_VERSION=v1.1.1

# FQDN του mail server. Πρέπει να ταιριάζει με:
#   A record  (mail.example.com -> IP του server)
#   PTR / reverse DNS της IP (IP -> mail.example.com) - ρυθμίζεται στον πάροχο του VPS
STALWART_HOSTNAME=mail.example.com

TZ=Europe/Athens

# Προαιρετικό: σταθερός λογαριασμός ανάκτησης (break-glass) διαχειριστή.
# Αν δεν οριστεί, στην πρώτη εκκίνηση τυπώνεται προσωρινός κωδικός στα logs.
# Δημιουργία: echo "admin:$(openssl rand -base64 24)"
#STALWART_RECOVERY_ADMIN=admin:LdX3n2UzI4esdDpWtVN0WD3JmNGi4T3A
