MAIL_HOSTNAME=mail.example.com
MAIL_DOMAIN=example.com
# Επιπλέον domains στον ίδιο mail server (MX -> MAIL_HOSTNAME). Κενό = κανένα.
#MAIL_EXTRA_DOMAIN_1=example.net
#MAIL_EXTRA_DOMAIN_2=
STALWART_VERSION=v1.1.1
TZ=Europe/Athens
# Προαιρετικό break-glass admin:  echo "admin:$(openssl rand -base64 24)"
STALWART_RECOVERY_ADMIN=
# Θύρα στον localhost του server για SSH tunnel στο admin (default 18080)
#ADMIN_LOCAL_PORT=18080
# Webmail (SnappyMail) - https://webmail.<MAIL_DOMAIN>
#SNAPPYMAIL_VERSION=v2.38.2.1
#SNAPPYMAIL_ADMIN_PANEL=Off
# Ιδιωτικό δίκτυο Stalwart<->webmail. Βάλ' το στα Allowed IPs του Stalwart.
#MAILNET_SUBNET=10.253.53.0/28
